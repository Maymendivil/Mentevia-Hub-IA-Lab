/** LAB IA Aplicada · Base operativa */
const SPREADSHEET_ID = '1CrUE-tC7H4cBwosoA4AzPJXriCE2Hk302MxOc7GWTZ4';
const SHEETS = {sessions:'01_Sesiones',participants:'02_Participantes',promptExercises:'03_Aprende_a_pedir',challenges:'04_Retos',clusters:'05_Clusters',teams:'06_Equipos',challengeCards:'07_Tarjetas_Reto',config:'08_Configuracion'};
const PROMPT_LOGICAL_KEY=['session_id','participant_id','category'];
const CARD_LOGICAL_KEY=['session_id','team_id'];
const ADMIN_ENTITIES={challenge:{sheet:SHEETS.challenges,id:'challenge_id',key:['session_id','challenge_id']},cluster:{sheet:SHEETS.clusters,id:'cluster_id',key:['session_id','cluster_id'],extra:['challenge_ids']},team:{sheet:SHEETS.teams,id:'team_id',key:['session_id','team_id'],extra:['visible_id','participant_ids','challenge_id','card_status']},participant:{sheet:SHEETS.participants,id:'participant_id',key:['session_id','participant_id']},challenge_card:{sheet:SHEETS.challengeCards,id:'card_id',key:CARD_LOGICAL_KEY}};

function doGet(e){try{const p=(e&&e.parameter)||{};assertApiKey_(p.api_key||p.apiKey);if(String(p.operation||'')!=='session_snapshot')throw new Error('Operación GET no admitida.');const id=required_(p.session_id,'session_id');return json_({success:true,operation:'session_snapshot',session_id:id,participants:readRows_(SHEETS.participants,id),prompt_exercises:readRows_(SHEETS.promptExercises,id),challenges:readRows_(SHEETS.challenges,id),clusters:readRows_(SHEETS.clusters,id),teams:readRows_(SHEETS.teams,id),challenge_cards:readRows_(SHEETS.challengeCards,id)});}catch(error){return jsonError_(error)}}

function doPost(e){try{const body=parseRequestBody_(e);assertApiKey_(body.api_key||body.apiKey);const operation=String(body.operation||'').trim(),data=body.data||body.payload||body;
if(operation==='prompt_exercise')return json_({success:true,operation:operation,...upsertPromptExercise_(data)});
if(operation==='challenge_card')return json_({success:true,operation:operation,...upsertChallengeCard_(data)});
if(operation==='sync_session_data')return json_({success:true,operation:operation,...syncSessionData_(data)});
if(operation==='admin_upsert')return json_({success:true,operation:operation,...adminUpsert_(data)});
if(operation==='admin_delete')return json_({success:true,operation:operation,...adminDelete_(data)});
if(operation==='admin_reset_card')return json_({success:true,operation:operation,...resetCard_(data)});
throw new Error('Operación POST no admitida.');}catch(error){return jsonError_(error)}}

function upsertPromptExercise_(input){const data=normalizeObject_(input);required_(data.session_id,'session_id');required_(data.participant_id,'participant_id');required_(data.category,'category');data.record_id=data.record_id||generateId_('prompt');data.status=data.status||'completed';return upsertRow_(SHEETS.promptExercises,data,PROMPT_LOGICAL_KEY,'record_id',now_())}
function upsertChallengeCard_(input){const data=normalizeObject_(input);required_(data.session_id,'session_id');required_(data.team_id,'team_id');data.card_id=data.card_id||generateId_('card');data.status=data.status||'draft';return upsertRow_(SHEETS.challengeCards,data,CARD_LOGICAL_KEY,'card_id',now_())}

function syncSessionData_(input){const data=normalizeObject_(input),sessionId=required_(data.session_id,'session_id'),result={};const groups=[['participants','participant'],['challenges','challenge'],['clusters','cluster'],['teams','team']];groups.forEach(function(pair){const rows=Array.isArray(data[pair[0]])?data[pair[0]]:[];result[pair[0]]=rows.map(function(row){row.session_id=sessionId;return adminUpsert_({entity:pair[1],record:row}).record})});return {action:'synced',session_id:sessionId,records:result}}
function adminUpsert_(input){const entity=required_(input.entity,'entity'),definition=ADMIN_ENTITIES[entity];if(!definition)throw new Error('Entidad administrativa no admitida.');const record=normalizeObject_(input.record||input);required_(record.session_id,'session_id');ensureHeaders_(getSheet_(definition.sheet),definition.extra||[]);record[definition.id]=record[definition.id]||generateId_(entity==='challenge_card'?'card':entity);if(entity==='challenge_card'&&!record.status)record.status='draft';const result=upsertRow_(definition.sheet,record,definition.key,definition.id,now_());return {action:result.action,entity:entity,record:result.record}}
function adminDelete_(input){const entity=required_(input.entity,'entity'),definition=ADMIN_ENTITIES[entity];if(!definition)throw new Error('Entidad administrativa no admitida.');const sessionId=required_(input.session_id,'session_id'),id=required_(input.id,'id'),sheet=getSheet_(definition.sheet),headers=getHeaders_(sheet),found=findRowBySessionAndId_(sheet,headers,sessionId,definition.id,id);if(!found)throw new Error('No se encontró el registro solicitado.');sheet.deleteRow(found.rowNumber);return {action:'deleted',entity:entity,id:id}}
function resetCard_(input){const sessionId=required_(input.session_id,'session_id'),teamId=required_(input.team_id,'team_id'),card=adminDelete_({entity:'challenge_card',session_id:sessionId,id:required_(input.card_id,'card_id')});const teamSheet=getSheet_(SHEETS.teams);ensureHeaders_(teamSheet,['card_status']);const team=findRowByLogicalKey_(teamSheet,getHeaders_(teamSheet),['session_id','team_id'],{session_id:sessionId,team_id:teamId});if(team){team.data.card_status='not_started';team.data.updated_at=now_();writeRow_(teamSheet,getHeaders_(teamSheet),team.rowNumber,team.data)}return {action:'reset',team_id:teamId,card:card}}

function upsertRow_(sheetName,input,logicalKey,idColumn,now){const sheet=getSheet_(sheetName),headers=getHeaders_(sheet);validateHeaders_(headers,logicalKey.concat([idColumn,'created_at','updated_at']));const existing=findRowByLogicalKey_(sheet,headers,logicalKey,input);if(existing){const merged=Object.assign({},existing.data,input);merged[idColumn]=existing.data[idColumn]||input[idColumn];merged.created_at=existing.data.created_at||now;merged.updated_at=now;writeRow_(sheet,headers,existing.rowNumber,merged);return {action:'updated',record:merged}}const record=Object.assign({},input);record[idColumn]=record[idColumn]||generateId_(idColumn==='card_id'?'card':'record');record.created_at=now;record.updated_at=now;appendRow_(sheet,headers,record);return {action:'created',record:record}}
function readRows_(sheetName,sessionId){const sheet=getSheet_(sheetName),headers=getHeaders_(sheet),values=sheet.getDataRange().getValues(),i=headers.indexOf('session_id');if(i<0)throw new Error('La pestaña "'+sheetName+'" no tiene session_id.');return values.slice(1).filter(function(row){return row.some(function(cell){return cell!==''&&cell!==null})}).map(function(row){return rowToObject_(headers,row)}).filter(function(row){return String(row.session_id)===String(sessionId)})}
function findRowByLogicalKey_(sheet,headers,logicalKey,input){const values=sheet.getDataRange().getValues(),indexes=logicalKey.map(function(key){const i=headers.indexOf(key);if(i<0)throw new Error('Falta la columna lógica "'+key+'" en '+sheet.getName()+'.');return i});for(let r=1;r<values.length;r++){if(indexes.every(function(column,index){return String(values[r][column]||'')===String(input[logicalKey[index]]||'')}))return {rowNumber:r+1,data:rowToObject_(headers,values[r])}}return null}
function findRowBySessionAndId_(sheet,headers,sessionId,idColumn,id){return findRowByLogicalKey_(sheet,headers,['session_id',idColumn],{session_id:sessionId,[idColumn]:id})}
function ensureHeaders_(sheet,headers){if(!headers.length)return;const current=getHeaders_(sheet),missing=headers.filter(function(header){return current.indexOf(header)<0});if(missing.length)sheet.getRange(1,current.length+1,1,missing.length).setValues([missing])}
function keyObject_(key,value){const o={};o[key]=value;return o}
function writeRow_(sheet,headers,rowNumber,data){sheet.getRange(rowNumber,1,1,headers.length).setValues([headers.map(function(header){return valueForSheet_(data[header])})])}
function appendRow_(sheet,headers,data){sheet.getRange(sheet.getLastRow()+1,1,1,headers.length).setValues([headers.map(function(header){return valueForSheet_(data[header])})])}
function rowToObject_(headers,row){return headers.reduce(function(record,header,index){record[header]=serializeCell_(row[index]);return record},{})}
function getHeaders_(sheet){const n=sheet.getLastColumn();if(!n)throw new Error('La pestaña "'+sheet.getName()+'" no tiene encabezados.');return sheet.getRange(1,1,1,n).getValues()[0].map(function(header){return String(header||'').trim()})}
function validateHeaders_(headers,requiredHeaders){requiredHeaders.forEach(function(header){if(headers.indexOf(header)<0)throw new Error('Falta la columna requerida "'+header+'".')})}
function getSheet_(sheetName){const sheet=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(sheetName);if(!sheet)throw new Error('No existe la pestaña "'+sheetName+'".');return sheet}
function parseRequestBody_(e){if(!e||!e.postData||!e.postData.contents)throw new Error('El cuerpo de la solicitud está vacío.');try{return JSON.parse(e.postData.contents)}catch(error){throw new Error('El cuerpo debe ser JSON válido.')}}
function normalizeObject_(input){if(!input||typeof input!=='object'||Array.isArray(input))throw new Error('data debe ser un objeto JSON.');return Object.keys(input).reduce(function(result,key){if(['api_key','apiKey','operation','data','payload','entity','record'].indexOf(key)<0)result[key]=input[key];return result},{})}
function assertApiKey_(candidate){const expected=PropertiesService.getScriptProperties().getProperty('LAB_API_KEY');if(!expected)throw new Error('No está configurada la Script Property LAB_API_KEY.');if(!candidate||String(candidate)!==String(expected))throw new Error('API key inválida.')}
function required_(value,name){if(value===undefined||value===null||String(value).trim()==='')throw new Error('El campo "'+name+'" es obligatorio.');return value}
function generateId_(prefix){return [prefix,Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMddHHmmss'),Utilities.getUuid().replace(/-/g,'').slice(0,10)].join('_')}
function now_(){return Utilities.formatDate(new Date(),Session.getScriptTimeZone(),"yyyy-MM-dd'T'HH:mm:ssXXX")}
function valueForSheet_(value){if(value===undefined||value===null)return '';if(value instanceof Date)return value;if(typeof value==='object')return JSON.stringify(value);return String(value)}
function serializeCell_(value){if(value===undefined||value===null)return '';if(value instanceof Date)return Utilities.formatDate(value,Session.getScriptTimeZone(),"yyyy-MM-dd'T'HH:mm:ssXXX");return String(value)}
function json_(payload){return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(ContentService.MimeType.JSON)}
function jsonError_(error){return json_({success:false,error:error&&error.message?error.message:String(error)})}
